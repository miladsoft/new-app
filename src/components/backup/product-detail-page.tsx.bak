import { useState, useEffect } from "react";
import { useParams, Link } from "react-router-dom";
import { motion } from "framer-motion";
import { Button } from "./ui/button";
import { 
  Heart, 
  Share, 
  Check, 
  ArrowLeft,
  ArrowRight,
  Star,
  Eye,
  ChevronRight,
  Sparkles
  Eye,
  ChevronRight,
  Sparkles
} from "lucide-react";
import { cn } from "@/lib/utils";
import { products } from "./data/products";
import { ProductProps, ProductCard } from "./ui/product-card";

interface ProductImage {
  src: string;
  alt: string;
}

interface ProductColor {
  name: string;
  value: string;
}

interface ProductVariant {
  name: string;
  options: string[];
}

export function ProductDetailPage() {
  const { productId } = useParams();
  
  // Find the product based on the ID from URL params
  const product = products.find(p => p.id === productId);
  
  const [selectedColor, setSelectedColor] = useState<string | null>(null);
  const [selectedVariant, setSelectedVariant] = useState<string | null>(null);
  const [activeImage, setActiveImage] = useState(0);
  const [isLoading, setIsLoading] = useState(true);
  const [relatedProducts, setRelatedProducts] = useState<ProductProps[]>([]);

  // Simulate loading state for better UX
  useEffect(() => {
    setIsLoading(true);
    // Simulate a network request
    const timer = setTimeout(() => {
      setIsLoading(false);
    }, 800);
    return () => clearTimeout(timer);
  }, [productId]);
  
  // Find related products
  useEffect(() => {
    if (product) {
      // Find products in the same category, excluding the current product
      const related = products
        .filter(p => p.category === product.category && p.id !== product.id)
        .slice(0, 4);
      setRelatedProducts(related);
    }
  }, [product]);
  
  // If product not found
  if (!product && !isLoading) {
    return (
      <div className="container mx-auto px-4 py-16 text-center">
        <div className="bg-gradient-to-r from-[#176c91] to-[#1a7ca6] p-8 rounded-2xl shadow-xl">
          <h1 className="text-2xl font-semibold mb-4 text-white">Product Not Found</h1>
          <p className="text-white/90 mb-8">
            The product you are looking for does not exist or has been removed.
          </p>
          <Button 
            asChild
            className="bg-white text-[#176c91] hover:bg-white/90 hover:text-[#176c91] transition-all"
          >
            <Link to="/">
              <ArrowLeft className="mr-2 h-4 w-4" />
              Back to Home
            </Link>
          </Button>
        </div>
      </div>
    );
  }
  
  // Mock data for product details that would typically come from a database
  const productImages: ProductImage[] = product ? [
    { src: product.imageSrc, alt: product.name },
    { src: "https://images.unsplash.com/photo-1581539250439-c96689b516dd?q=80&w=800&auto=format&fit=crop", alt: `${product.name} - Angle 2` },
    { src: "https://images.unsplash.com/photo-1567538096630-e0c55bd6374c?q=80&w=800&auto=format&fit=crop", alt: `${product.name} - Angle 3` },
    { src: "https://images.unsplash.com/photo-1550226891-ef816aed4a98?q=80&w=800&auto=format&fit=crop", alt: `${product.name} - Detail` },
  ] : [];
  
  const colors: ProductColor[] = [
    { name: "Blue", value: "#176c91" },
    { name: "Red", value: "#ea252b" },
    { name: "Ebony", value: "#2C2C2C" },
    { name: "Cream", value: "#F5F5DC" },
  ];
  
  const variants: ProductVariant[] = [
    { name: "Size", options: ["Small", "Medium", "Large"] },
    { name: "Material", options: ["Premium Fabric", "Leather", "Velvet"] }
  ];
  
  const features = [
    "Handcrafted with premium materials",
    "Designed for comfort and durability",
    "Timeless aesthetic that complements any décor",
    "Sustainably sourced materials"
  ];

  if (isLoading) {
    return (
      <div className="container mx-auto py-20 px-4 flex justify-center items-center min-h-[60vh]">
        <div className="flex flex-col items-center">
          <div className="w-16 h-16 border-4 border-[#176c91] border-t-[#ea252b] rounded-full animate-spin"></div>
          <p className="mt-4 text-[#176c91] font-medium">Loading product information...</p>
        </div>
      </div>
    );
  }
  
  if (!product) {
    return null; // This shouldn't happen due to the earlier check, but TypeScript needs it
  }

  // Get back link based on product category
  const getCategoryLink = () => {
    const categorySlug = product.category.toLowerCase().replace(/\s+/g, '-');
    return `/category/${categorySlug}`;
  };
    return (
    <div>
      {/* Hero product banner */}
      <div 
        className="w-full bg-gradient-to-r from-[#176c91] to-[#1a7ca6] py-12 mb-12"
        style={{
          backgroundImage: `url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E")`,
        }}
      >
        <div className="container mx-auto px-4">
          <div className="flex flex-col items-center text-center">
            <motion.h1 
              className="text-3xl md:text-5xl font-bold text-white mb-4"
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.6 }}
            >
              {product.name}
            </motion.h1>
            <motion.div 
              className="flex items-center gap-2 text-white/90 text-sm"
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              transition={{ duration: 0.6, delay: 0.3 }}
            >
              <Link to="/" className="hover:text-white transition-colors">Home</Link>
              <ChevronRight className="h-3 w-3" />
              <Link to={getCategoryLink()} className="hover:text-white transition-colors">{product.category}</Link>
              <ChevronRight className="h-3 w-3" />
              <span>{product.name}</span>
            </motion.div>
          </div>
        </div>
      </div>

      <div className="container mx-auto px-4 pb-20">
        {/* Product detail layout */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-20">
          {/* Product images */}
          <motion.div 
            initial={{ opacity: 0, x: -20 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ duration: 0.6 }}
            className="space-y-8"
          >
            {/* Main image */}
            <div className="relative aspect-square rounded-2xl overflow-hidden shadow-2xl bg-gradient-to-br from-[#176c91]/5 to-[#ea252b]/5 p-1">
              <div className="absolute top-4 left-4 z-10 flex flex-col gap-2">
                {product.isNew && (
                  <span className="inline-block bg-[#ea252b] text-white text-xs uppercase tracking-wider font-bold px-3 py-1 rounded-full shadow-lg">
                    New
                  </span>
                )}
                {product.isFeatured && (
                  <span className="inline-block bg-[#176c91] text-white text-xs uppercase tracking-wider font-bold px-3 py-1 rounded-full shadow-lg">
                    Featured
                  </span>
                )}
              </div>
              <div className="w-full h-full rounded-xl overflow-hidden">
                <motion.img
                  src={productImages[activeImage].src}
                  alt={productImages[activeImage].alt}
                  className="w-full h-full object-cover object-center"
                  initial={{ scale: 1 }}
                  whileHover={{ scale: 1.05 }}
                  transition={{ duration: 0.4 }}
                />
              </div>
            </div>
            
            {/* Image thumbnails */}
            <div className="flex gap-4 justify-center">
              {productImages.map((image, index) => (
                <button
                  key={index}
                  onClick={() => setActiveImage(index)}
                  className={cn(
                    "relative w-20 h-20 rounded-lg overflow-hidden transition-all duration-300",
                    activeImage === index 
                      ? "ring-4 ring-[#176c91] shadow-lg" 
                      : "ring-2 ring-transparent hover:ring-[#176c91]/50 shadow"
                  )}
                >
                  <img 
                    src={image.src} 
                    alt={image.alt} 
                    className="w-full h-full object-cover object-center" 
                  />
                  {activeImage === index && (
                    <div className="absolute inset-0 bg-[#176c91]/10 flex items-center justify-center">
                      <Eye className="h-5 w-5 text-white shadow" />
                    </div>
                  )}
                </button>
              ))}
            </div>
          </motion.div>

          {/* Product info */}
          <motion.div 
            initial={{ opacity: 0, x: 20 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ duration: 0.6 }}
            className="flex flex-col"
          >
            <div className="bg-white rounded-2xl shadow-lg p-8 border border-[#176c91]/10">
              <Link 
                to={getCategoryLink()}
                className="inline-flex items-center text-sm font-medium text-[#176c91] hover:text-[#ea252b] transition-colors mb-3"
              >
                <span>{product.category}</span>
                <ChevronRight className="h-3 w-3 ml-1" />
              </Link>
              
              <h1 className="text-3xl md:text-4xl font-bold mb-4 text-gray-800">{product.name}</h1>
              
              <div className="flex items-center gap-2 mb-6">
                <div className="flex">
                  {[1, 2, 3, 4, 5].map((star) => (
                    <Star 
                      key={star} 
                      className="h-4 w-4 text-[#ea252b]" 
                      fill={star <= 4 ? "currentColor" : "none"}
                    />
                  ))}
                </div>
                <span className="text-sm text-gray-500">4.0 (12 reviews)</span>
              </div>
              
              <div className="bg-gradient-to-r from-[#176c91]/5 to-[#ea252b]/5 rounded-xl p-6 mb-8">
                <p className="text-gray-700 leading-relaxed">
                  {product.description || "A beautifully crafted piece that combines functionality with timeless design. This item will complement any interior with its elegant presence."}
                </p>
              </div>
              
              {/* Color selection */}
              <div className="mb-8">
                <h3 className="text-base font-semibold mb-4 flex items-center text-gray-800">
                  <span className="mr-2 bg-[#176c91] text-white p-1 rounded">
                    <Sparkles className="h-3 w-3" />
                  </span>
                  Color Options
                </h3>
                <div className="flex flex-wrap gap-3">
                  {colors.map((color) => (
                    <button
                      key={color.name}
                      onClick={() => setSelectedColor(color.name)}
                      className={cn(
                        "relative w-14 h-14 rounded-full flex items-center justify-center transition-transform",
                        "shadow-md border-2 hover:scale-110",
                        selectedColor === color.name 
                          ? "border-[#176c91] transform scale-110" 
                          : "border-transparent"
                      )}
                      title={color.name}
                    >
                      <span 
                        className="w-10 h-10 rounded-full block" 
                        style={{ backgroundColor: color.value }}
                      ></span>
                      {selectedColor === color.name && (
                        <span className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-white">
                          <Check className="h-5 w-5 drop-shadow-md" />
                        </span>
                      )}
                    </button>
                  ))}
                </div>
                <p className="text-sm text-gray-500 mt-3 font-medium">
                  Selected: <span className="text-[#176c91]">{selectedColor || "None selected"}</span>
                </p>
              </div>
              
              {/* Variants selection */}
              {variants.map((variant) => (
                <div key={variant.name} className="mb-8">
                  <h3 className="text-base font-semibold mb-4 flex items-center text-gray-800">
                    <span className="mr-2 bg-[#ea252b] text-white p-1 rounded">
                      <Sparkles className="h-3 w-3" />
                    </span>
                    {variant.name}
                  </h3>
                  <div className="flex flex-wrap gap-2">
                    {variant.options.map((option) => (
                      <button
                        key={option}
                        onClick={() => setSelectedVariant(option)}
                        className={cn(
                          "px-5 py-3 rounded-lg border-2 transition-all font-medium",
                          selectedVariant === option 
                            ? "border-[#176c91] bg-[#176c91] text-white shadow-md" 
                            : "border-gray-200 hover:border-[#176c91]/50 text-gray-700"
                        )}
                      >
                        {option}
                      </button>
                    ))}
                  </div>
                </div>
              ))}
              
              {/* Product features */}
              <div className="mb-8">
                <h3 className="text-base font-semibold mb-4 flex items-center text-gray-800">
                  <span className="mr-2 bg-[#176c91] text-white p-1 rounded">
                    <Check className="h-3 w-3" />
                  </span>
                  Features
                </h3>
                <ul className="space-y-3 bg-gray-50 p-5 rounded-xl">
                  {features.map((feature, index) => (
                    <li key={index} className="flex items-center gap-3 text-gray-700">
                      <div className="flex-shrink-0 w-6 h-6 rounded-full bg-[#ea252b]/10 flex items-center justify-center">
                        <Check className="h-3 w-3 text-[#ea252b]" />
                      </div>
                      <span className="font-medium">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
              
              {/* Actions */}
              <div className="flex flex-col sm:flex-row gap-4">
                <Button 
                  className="flex-1 bg-[#176c91] hover:bg-[#176c91]/90 text-white rounded-lg py-6 text-lg font-semibold shadow-lg"
                ></Button>
                  <ArrowRight className="mr-2 h-5 w-5" />
                  View in Showroom
                </Button>
                <div className="flex gap-2">
                  <Button 
                    variant="outline" 
                    size="icon" 
                    className="rounded-lg border-2 border-[#ea252b] bg-white text-[#ea252b] hover:bg-[#ea252b]/5"
                    title="Add to favorites"
                  >
                    <Heart className="h-5 w-5" />
                  </Button>
                  <Button 
                    variant="outline" 
                    size="icon" 
                    className="rounded-lg border-2 border-[#176c91] bg-white text-[#176c91] hover:bg-[#176c91]/5"
                    title="Share"
                  >
                    <Share className="h-5 w-5" />
                  </Button>
                </div>
              </div>
            </div>
          </motion.div>
        </div>
        
        {/* Related products */}
        {relatedProducts.length > 0 && (
          <div className="mt-24"></div>
            <div className="flex items-center justify-between mb-10">
              <div className="relative">
                <h2 className="text-2xl font-bold text-gray-800">More from this collection</h2>
                <div className="absolute -bottom-2 left-0 w-24 h-1 bg-[#ea252b]"></div>
              </div>
              <Link 
                to={getCategoryLink()}
                className="text-[#176c91] hover:text-[#ea252b] font-medium flex items-center transition-colors"
              >
                View All
                <ArrowRight className="ml-1 w-4 h-4" />
              </Link>
            </div>
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {relatedProducts.map((relatedProduct, index) => (
                <ProductCard 
                  key={relatedProduct.id} 
                  product={relatedProduct}
                  index={index}
                />
              ))}
            </div>
          </div>
        )}
        
        {/* Back to category */}
        <div className="mt-16 text-center">
          <Button 
            variant="outline" 
            asChild
            className="border-2 border-[#176c91] text-[#176c91] hover:bg-[#176c91] hover:text-white transition-all py-6 px-8 font-semibold rounded-lg"
          >
            <Link to={getCategoryLink()}>
              <ArrowLeft className="mr-2 h-4 w-4" />
              Back to {product.category} Collection
            </Link>
          </Button>
        </div>
      </div>
    </div>
  );
}